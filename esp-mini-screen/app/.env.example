# Copy to deploy/.env on the server, then: chmod 600 deploy/.env. Never commit the real file.
# Secrets and bootstrap values only. Everything you tune (timing, thresholds, focus systems)
# is on the settings page and stored in the database.

# Host port for the settings page (the container always listens on 8080).
HOST_PORT=8081

# Time zone for times shown on the screen (24-hour).
TZ=America/Halifax

# The screen's address. Used only to seed the setting on first start.
SCREEN_URL=http://<screen-ip>

# --- Used from slice S-2 (live status); safe to fill in now ---
# The Beszel hub, reachable from this container. A name that Pi-hole resolves is fine.
BESZEL_URL=http://beszel:8090
# The read-only app user created in Beszel (docs/07, "Before install").
BESZEL_USER=esp-screen@example.com
BESZEL_PASSWORD=change-me

# Optional: database backups kept in the volume, and hours between them.
# BACKUP_KEEP=7
# BACKUP_INTERVAL_HOURS=24
