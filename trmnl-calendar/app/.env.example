# Copy to deploy/.env on the server, then: chmod 600 deploy/.env. Never commit the real file.
# Names only here. Infrastructure and secrets live in the environment; everything a user edits is in the database.

# --- Slice 0 ---
# Host port that serves the web page (the container always listens on 8080).
HOST_PORT=8080
# Backups: kept automatic copies, and hours between them. Pre-migration and manual backups are never pruned.
BACKUP_KEEP=14
BACKUP_INTERVAL_HOURS=24

# --- Used from slice 4 (Terminus push); safe to fill in now ---
TERMINUS_URL=http://<server-ip>:2300
TERMINUS_LOGIN=calendar
TERMINUS_PASSWORD=change-me
# The address Terminus uses to fetch the image from this app. Use the IP, not a name.
PUBLIC_BASE_URL=http://<server-ip>:8080
TERMINUS_MODEL_NAME=og_plus
# Optional: name of the screen the app creates in Terminus (an existing one with this name is reused).
# TERMINUS_SCREEN_NAME=trmnl-calendar
# Optional: seconds between checks (minimum 60); the picture is only sent when it changed.
# TERMINUS_PUSH_INTERVAL=900
# TERMINUS_VERIFY_TLS=true

# Optional: the "Look up online" holidays page (other countries). Set to off to hide it.
# It sends only a country code and a year to the service, and only when you click Look up.
# HOLIDAY_LOOKUP=on
# HOLIDAY_API_URL=https://date.nager.at/api/v3

# Optional: flight status on events (docs/21, ADR-0015).
# An event with a flight code such as AC663 gets "(On time)", "(Delayed)" and so on after its title.
# It sends only the flight code and the date to AeroDataBox, on a schedule per flight.
# FLIGHT_STATUS=off
# Your AeroDataBox key from RapidAPI (rapidapi.com/aedbx-aedbx/api/aerodatabox, "X-RapidAPI-Key"). A secret.
# FLIGHT_API_KEY=
# FLIGHT_API_URL=https://aerodatabox.p.rapidapi.com
# The home airport and the monthly lookup limit are settings on the Settings page (ADR-0005).
# These two only fill them the first time the app starts; after that the Settings page wins.
# A flight landing at the home airport shows its arrival time and arrival status.
# FLIGHT_HOME_AIRPORT=YHZ
# The free plan allows 400 units a month and a lookup costs 2, so keep this at 190 or less.
# FLIGHT_MONTHLY_LIMIT=100
