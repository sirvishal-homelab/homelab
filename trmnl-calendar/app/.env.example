# Copy to deploy/.env on the server, then: chmod 600 deploy/.env. Never commit the real file.
# Names only here. Infrastructure and secrets live in the environment; everything a user edits is in the database.

# --- Slice 0 ---
# Host port that serves the web page (the container always listens on 8080).
HOST_PORT=8080
# Backups: kept automatic copies, and hours between them. Pre-migration and manual backups are never pruned.
BACKUP_KEEP=14
BACKUP_INTERVAL_HOURS=24

# --- Used from slice 4 (Terminus push); safe to fill in now ---
TERMINUS_URL=http://<server-ip>:2300
TERMINUS_LOGIN=calendar
TERMINUS_PASSWORD=change-me
# The address Terminus uses to fetch the image from this app. Use the IP, not a name.
PUBLIC_BASE_URL=http://<server-ip>:8080
TERMINUS_MODEL_NAME=og_plus
